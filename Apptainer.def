Bootstrap: docker
From: condaforge/mambaforge:latest
%files
    env/environment.yml /opt/environment.yml

%post
    export DEBIAN_FRONTEND=noninteractive

    # 1. Install system essentials and tools
    apt-get update && apt-get install -y git wget curl build-essential

    # 2. Install Rust
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
    export PATH="/root/.cargo/bin:$PATH"

    # 3. Create the Mamba environment
    mamba env create -f /opt/environment.yml
    
    # Activate the environment for the remaining build steps
    export PATH=/opt/conda/envs/realtime_decoding/bin:$PATH

    # 4. Register the Jupyter kernel spec
    python -m ipykernel install --user --name realtime_decoding

    # 5. Clone and install Relay-BP
    mkdir -p /opt/external_repos
    cd /opt/external_repos
    if [ ! -d relay ]; then
        git clone https://github.com/trmue/relay.git
    fi
    cd relay
    pip install ".[stim]"

    # 6. Clone and compile uf_decoder (Using Meson/Ninja)
    cd /opt/external_repos
    if [ ! -d uf_decoder ]; then
        git clone https://github.com/acatspirit/uf_decoder.git
    fi
    cd uf_decoder
    
    # Install the build tools required by the repository
    pip install meson ninja
    
    # Configure the build and compile the C code
    meson setup build --buildtype=release
    cd build
    ninja

    # Clean cache
    mamba clean -a -y

%environment
    # Set default path
    export PATH=/opt/conda/envs/realtime_decoding/bin:$PATH
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    
    # Tell Python where to find the py_wrapper folder
    export PYTHONPATH="/opt/external_repos/uf_decoder:$PYTHONPATH"