Bootstrap: docker
From: condaforge/mambaforge:latest

%files
    # Copy your environment.yml into the container build context
    environment.yml /opt/environment.yml

%post
    export DEBIAN_FRONTEND=noninteractive

    # 1. Install system essentials and tools (git, curl, build tools)
    apt-get update && apt-get install -y git wget curl build-essential

    # 2. Install Rust (required for compiling packages like stim / relay)
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
    export PATH="/root/.cargo/bin:$PATH"

    # 3. Create the Mamba environment from your environment.yml
    mamba env create -f /opt/environment.yml
    
    # Activate the environment for the remaining build steps
    export PATH=/opt/conda/envs/realtime_decoding/bin:$PATH

    # 4. Register the Jupyter kernel spec inside the container
    python -m ipykernel install --user --name realtime_decoding

    # 5. Clone and install the Relay-BP repository
    mkdir -p /opt/external_repos
    cd /opt/external_repos
    if [ ! -d relay ]; then
        git clone https://github.com/trmue/relay.git
    fi
    cd relay
    pip install ".[stim]"

    # Clean cache to optimize container file size
    mamba clean -a -y

%environment
    # Set default path to use your conda environment inside the container
    export PATH=/opt/conda/envs/realtime_decoding/bin:$PATH
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8